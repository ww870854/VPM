<Window x:Class="VPM.Windows.SupportImage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Language="clr-namespace:VPM.Language;assembly=VPM"
        xmlns:local="clr-namespace:VPM.Windows"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="{Binding [SupportMe], Source={x:Static Language:LanguageManager.Instance}, Mode=OneWay}" 
        Height="520" Width="480"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="-1" ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Value="Normal">
                        <Setter Property="Margin" Value="8" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border x:Name="WindowRootBorder"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            CornerRadius="5"
            BorderBrush="#FF676767"
            BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect 
                ShadowDepth="0" 
                BlurRadius="5" 
                Opacity="0.6" 
                Color="#FF2C2C2C" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="Transparent">
                    <TextBlock 
                        Text="{Binding [SupportMe], Source={x:Static Language:LanguageManager.Instance}, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        Foreground="#FFF"
                        FontSize="12"/>

                    <Button 
                        Content="✗"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#999999"
                        FontSize="14"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border 
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="0,8,0,0">
                                                <ContentPresenter 
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <WindowChrome.IsHitTestVisibleInChrome>True</WindowChrome.IsHitTestVisibleInChrome>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="10">
                    <Image 
                        x:Name="DisplayImage"
                        Stretch="Uniform"/>
                    <TextBlock 
                        x:Name="StatusText"
                        Text="{Binding [text_7], Source={x:Static Language:LanguageManager.Instance}, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="Gray"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
